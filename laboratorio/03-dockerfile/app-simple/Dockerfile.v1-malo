# =========================================================================
#  VERSION 1 - LA QUE HACE TODO EL MUNDO AL PRINCIPIO  (funciona, pero mal)
#  Constrúyela y mide su tamaño. Luego compárala con Dockerfile.v2-bueno
#  docker build -f Dockerfile.v1-malo -t app-simple:v1 .
# =========================================================================

# Imagen con Maven + JDK completo: pesa ~500 MB antes de meter nada nuestro
FROM maven:3.9-eclipse-temurin-21

WORKDIR /app

# ERROR 1: copiamos TODO de golpe. Cualquier cambio en cualquier fichero
# invalida la cache y obliga a redescargar todas las dependencias Maven.
COPY . .

# ERROR 2: compilamos dentro de la imagen final -> el JDK, Maven y el
# repositorio ~/.m2 entero se quedan dentro de la imagen para siempre.
RUN mvn clean package -DskipTests

EXPOSE 8080

# ERROR 3: forma "shell". Arranca /bin/sh -c "java -jar ...", asi que
# PID 1 es la shell y NO reenvia SIGTERM -> no hay apagado elegante.
CMD java -jar target/app.jar
